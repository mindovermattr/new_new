    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typeorm": "typeorm-ts-node-esm",
    "migration:generate": "npm run typeorm -- migration:generate ./src/migrations/Migration -d ./src/typeorm.config.ts --esm",
    "migration:run": "npm run typeorm -- migration:run -d ./src/typeorm.config.ts"
  },
